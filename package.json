{
  "name": "save-je",
  "version": "0.1.1",
  "description": "Minimal & fast Obsidian sync plugin tailored specifically for IDrive e2 (S3-compatible) storage.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "sync",
    "idrive",
    "idrive-e2",
    "s3"
  ],
  "author": "hakeem",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.12",
    "esbuild": "^0.23.0",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.3",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.620.0",
    "@smithy/fetch-http-handler": "^3.2.4",
    "@smithy/protocol-http": "^4.1.0",
    "@smithy/querystring-builder": "^3.0.3",
    "@smithy/types": "^3.2.0",
    "buffer": "^6.0.3",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0"
  }
}
